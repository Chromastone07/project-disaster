# GEMINI_API_KEY: Required for Gemini AI API calls.
# Generate a key at https://aistudio.google.com/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# JWT_SECRET: Secret key for signing JSON Web Tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-strong-random-secret"

# ADMIN_SECRET: Required secret key for registering new authority accounts.
ADMIN_SECRET="change-me-to-a-strong-admin-secret"

# DEFAULT_ADMIN_PASSWORD: Password for the auto-seeded admin account (admin@cserp.gov).
DEFAULT_ADMIN_PASSWORD="Admin@2024"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
